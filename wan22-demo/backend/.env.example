# Production provider endpoints. Copy to backend/.env after provider services
# and voice references have been installed.
COSYVOICE_URL=http://127.0.0.1:8191/synthesize
ASR_QA_URL=http://127.0.0.1:8191/transcribe
TTS_PROVIDER_MODE=required
LATENTSYNC_URL=http://127.0.0.1:8192/lipsync
SYNCNET_QA_URL=http://127.0.0.1:8192/sync-qa
LIPSYNC_PROVIDER_MODE=preferred
PROVIDER_TIMEOUT_SEC=1800
VISUAL_MASTER_RIFE_ENABLED=true
DUB_REQUIRED_RIFE=true
FACE_BINDING_THRESHOLD=0.35
FACE_BINDING_MARGIN=0.05
FACE_TRACK_MIN_FRAMES=3
FACE_TRACK_MIN_SIZE=32
FACE_TRACK_MAX_GAP_FRAMES=8
FACE_TRACK_REID_THRESHOLD=0.38
FACE_TRACK_ASSIGNMENT_COST=0.72
FACE_VISIBLE_RATIO_MIN=0.65
ASR_QA_SIMILARITY_MIN=0.70
SYNCNET_CONFIDENCE_MIN=3.0
SYNCNET_OFFSET_MAX_FRAMES=1
