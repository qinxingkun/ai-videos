{
  "1": {
    "class_type": "WanVideoVACEModelSelect",
    "_meta": { "title": "VACE 模块（身份参考引导）" },
    "inputs": {
      "vace_model": "Wan2_1-VACE_module_14B_fp8_e4m3fn.safetensors"
    }
  },
  "2": {
    "class_type": "WanVideoModelLoader",
    "_meta": { "title": "Wan2.1 T2V 14B + VACE extra_model" },
    "inputs": {
      "model": "Wan2_1-T2V-14B_fp8_e4m3fn.safetensors",
      "base_precision": "fp16",
      "quantization": "fp8_e4m3fn",
      "load_device": "offload_device",
      "attention_mode": "sdpa",
      "extra_model": ["1", 0]
    }
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "_meta": { "title": "Wan VAE" },
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "fp16"
    }
  },
  "4": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "_meta": { "title": "T5（WanVideoWrapper 非 scaled）" },
    "inputs": {
      "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors",
      "precision": "bf16",
      "load_device": "offload_device",
      "quantization": "disabled"
    }
  },
  "5": {
    "class_type": "WanVideoTextEncode",
    "_meta": { "title": "正/负向提示词" },
    "inputs": {
      "t5": ["4", 0],
      "positive_prompt": "cinematic shot of the same person, natural motion, consistent identity",
      "negative_prompt": "changing face, different person, morphing identity, blurry face, watermark, subtitles"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": { "title": "身份参考图（InstantID 定妆照，必须）" },
    "inputs": {
      "image": "lookbook.png",
      "upload": "image"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "场景起始帧（可选：有脸末帧；无脸时与定妆照相同或忽略）" },
    "inputs": {
      "image": "start_frame.png",
      "upload": "image"
    }
  },
  "8": {
    "class_type": "WanVideoVACEEncode",
    "_meta": { "title": "VACEEncode：ref_images 锁身份；input_frames 管场景" },
    "inputs": {
      "vae": ["3", 0],
      "width": 1280,
      "height": 720,
      "num_frames": 81,
      "strength": 1.0,
      "vace_start_percent": 0.0,
      "vace_end_percent": 1.0,
      "tiled_vae": true,
      "ref_images": ["6", 0],
      "input_frames": ["7", 0]
    }
  },
  "9": {
    "class_type": "WanVideoSampler",
    "_meta": { "title": "VACE 参考引导采样" },
    "inputs": {
      "model": ["2", 0],
      "image_embeds": ["8", 0],
      "text_embeds": ["5", 0],
      "steps": 20,
      "cfg": 5.0,
      "shift": 5.0,
      "seed": 0,
      "force_offload": true,
      "scheduler": "unipc",
      "riflex_freq_index": 0
    }
  },
  "10": {
    "class_type": "WanVideoDecode",
    "_meta": { "title": "VAE 解码" },
    "inputs": {
      "vae": ["3", 0],
      "samples": ["9", 0],
      "enable_vae_tiling": true,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    }
  },
  "11": {
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "输出 VACE 分段视频" },
    "inputs": {
      "images": ["10", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "vace_i2v",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
