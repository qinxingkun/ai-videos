{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "SDXL 底座（定妆照）" },
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "11": {
    "class_type": "InstantIDModelLoader",
    "_meta": { "title": "InstantID 权重" },
    "inputs": {
      "instantid_file": "ip-adapter.bin"
    }
  },
  "38": {
    "class_type": "InstantIDFaceAnalysis",
    "_meta": { "title": "InsightFace antelopev2" },
    "inputs": {
      "provider": "CPU"
    }
  },
  "16": {
    "class_type": "ControlNetLoader",
    "_meta": { "title": "InstantID ControlNet" },
    "inputs": {
      "control_net_name": "instantid_controlnet.safetensors"
    }
  },
  "13": {
    "class_type": "LoadImage",
    "_meta": { "title": "角色参考脸" },
    "inputs": {
      "image": "example.png",
      "upload": "image"
    }
  },
  "39": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "正向提示词（场景/服装/机位）" },
    "inputs": {
      "text": "cinematic portrait photo of the same person, natural lighting, sharp face details, 85mm lens",
      "clip": ["4", 1]
    }
  },
  "40": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "负向提示词" },
    "inputs": {
      "text": "photograph watermark, deformed, glitch, noisy, lowres, bad anatomy, different person, face morph",
      "clip": ["4", 1]
    }
  },
  "60": {
    "class_type": "ApplyInstantID",
    "_meta": { "title": "应用 InstantID 锁脸" },
    "inputs": {
      "instantid": ["11", 0],
      "insightface": ["38", 0],
      "control_net": ["16", 0],
      "image": ["13", 0],
      "model": ["4", 0],
      "positive": ["39", 0],
      "negative": ["40", 0],
      "weight": 0.8,
      "start_at": 0.0,
      "end_at": 1.0
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "定妆照分辨率（避开 1024 水印）" },
    "inputs": {
      "width": 1016,
      "height": 1016,
      "batch_size": 1
    }
  },
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "采样" },
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 4.5,
      "sampler_name": "ddpm",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["60", 0],
      "positive": ["60", 1],
      "negative": ["60", 2],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE 解码" },
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "保存定妆照/段首帧" },
    "inputs": {
      "filename_prefix": "lookbook/instantid",
      "images": ["8", 0]
    }
  }
}
